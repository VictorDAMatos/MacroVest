# mock = usa os repositórios demonstrativos locais (padrão)
# http  = envia propostas e execuções para o back-end configurado
VITE_API_MODE=mock

# URL base do back-end, sem barra no final.
# Exemplo local: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# Tempo máximo de espera por resposta, em milissegundos.
VITE_API_TIMEOUT_MS=15000
